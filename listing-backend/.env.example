DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"

# JWT Authentication
JWT_ACCESS_SECRET=replace-with-a-unique-access-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace-with-a-unique-refresh-secret-of-at-least-32-characters
JWT_REFRESH_EXPIRATION=7d
JWT_RESET_SECRET=replace-with-a-unique-reset-secret-of-at-least-32-characters
JWT_RESET_EXPIRATION=15m
JWT_VERIFY_SECRET=replace-with-a-unique-verify-secret-of-at-least-32-characters
JWT_VERIFY_EXPIRATION=24h

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sheltered-property-media
R2_PUBLIC_URL=https://media.example.com
R2_MAX_IMAGE_SIZE_BYTES=12582912
R2_MAX_VIDEO_SIZE_BYTES=104857600
R2_MAX_THUMBNAIL_SIZE_BYTES=1048576
R2_UPLOAD_URL_TTL_SECONDS=900
R2_UPLOAD_BATCH_TTL_MINUTES=1440

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
ADMIN_FULL_NAME=System Administrator
ADMIN_COUNTRY=Uganda

AUTH_COOKIE_SAME_SITE=lax

# Set the same random secret in the trusted proxy and backend deployment.
# The proxy should send it in X-Proxy-Secret and the visitor IP in X-Client-IP.
PROXY_SECRET=

MJ_APIKEY_PUBLIC=your-mailjet-public-api-key
MJ_APIKEY_PRIVATE=your-mailjet-private-api-key
EMAIL_FROM=verified-sender@example.com
EMAIL_FROM_NAME=Shelter
