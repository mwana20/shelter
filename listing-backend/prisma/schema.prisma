generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  fullName            String
  phone               String?
  dateOfBirth         DateTime
  country             String?
  role                Role                 @default(BUYER)
   accountStatus       AccountStatus        @default(APPROVED)
   approvedAt          DateTime?
   approvedById        String?
   approvedBy          User?                @relation("ApprovedOwners", fields: [approvedById], references: [id])
   approvedUsers       User[]               @relation("ApprovedOwners")
   notifications       Notification[]
  emailVerified       Boolean              @default(false)
  phoneVerified       Boolean              @default(false)
  companyName         String?
  agencyLicense       String?
  avatarUrl           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  bio                 String?
  district            String?
  neighborhood        String?
  region              String?
  auditLogs           AuditLog[]
  mediaUploadBatches  MediaUploadBatch[]
  unlockedProperties  LocationUnlock[]
  passwordResetTokens PasswordResetToken[]
  payments            Payment[]
  properties          Property[]           @relation("OwnerProperties")
  propertyReviews     PropertyReview[]      @relation("PropertyReviewActor")
  subscriptions       Subscription[]
  subscriptionPayments SubscriptionPayment[]
  subscriptionMapUnlocks SubscriptionMapUnlock[]
  verificationTokens  VerificationToken[]
  authSessions        AuthSession[]

  @@map("users")
}

model AuthSession {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  code      String
  userId    String
  expiresAt DateTime
  codeExpiresAt DateTime?
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Property {
  id                  String                @id @default(uuid())
  slug                String                @unique
  title               String
  description         String
  propertyType        String
  listingType         String
  price               Decimal               @db.Decimal(14, 2)
  currency            String                @default("USD")
  status              PropertyStatus        @default(PENDING_REVIEW)
  bedrooms            Int?
  bathrooms           Decimal?              @db.Decimal(3, 1)
  landSizeSqFt        Decimal?              @db.Decimal(12, 2)
  builtYear           Int?
  featured            Boolean               @default(false)
  viewsCount          Int                   @default(0)
  country             String
  region              String
  district            String
  neighborhood        String?
  exactAddress        String?
  latitude            Float?
  longitude           Float?
  directionsGuide     String?
  cadastralPlotNumber String?
  ownerId             String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  locationUnlocks     LocationUnlock[]
  payments            Payment[]
  owner               User                  @relation("OwnerProperties", fields: [ownerId], references: [id])
  lockOverride        PropertyLockOverride?
  media               Media[]
  reviewHistory       PropertyReview[]
  reviewNote          String?
  subscriptionMapUnlocks SubscriptionMapUnlock[]

  @@map("properties")
}

model PropertyLockOverride {
  id         String   @id @default(uuid())
  propertyId String   @unique
  isLocked   Boolean  @default(true)
  customFee  Decimal? @db.Decimal(10, 2)
  reason     String?
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_lock_overrides")
}

model PropertyReview {
  id         String         @id @default(uuid())
  propertyId String
  actorId    String
  fromStatus PropertyStatus
  toStatus   PropertyStatus
  action     String
  notes      String?
  createdAt  DateTime       @default(now())
  actor      User           @relation("PropertyReviewActor", fields: [actorId], references: [id])
  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@map("property_reviews")
}

model SubscriptionConfig {
  id                    String   @id @default("global_setting")
  baseMonthlyPrice      Decimal  @default(0) @db.Decimal(10, 2)
  currency              String   @default("USD")
  freeValidityDays      Int      @default(30)
  freeListingLimit      Int      @default(1)
  freeMapUnlockLimit    Int      @default(1)
  paidListingLimit      Int      @default(0)
  paidMapUnlockLimit    Int      @default(0)
  updatedAt             DateTime @updatedAt
  discounts             SubscriptionDiscount[]

  @@map("subscription_config")
}

model SubscriptionDiscount {
  id               String             @id @default(uuid())
  configId         String             @default("global_setting")
  minMonths        Int
  maxMonths        Int
  discountPercent  Decimal            @db.Decimal(5, 2)
  config           SubscriptionConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, minMonths, maxMonths])
  @@index([configId, minMonths, maxMonths])
  @@map("subscription_discounts")
}

model Subscription {
  id                String             @id @default(uuid())
  userId            String
  plan              SubscriptionPlan
  status            SubscriptionStatus @default(PENDING_PAYMENT)
  durationMonths    Int
  baseMonthlyPrice  Decimal            @db.Decimal(10, 2)
  originalTotal     Decimal            @db.Decimal(10, 2)
  discountPercent   Decimal            @db.Decimal(5, 2)
  discountAmount    Decimal            @db.Decimal(10, 2)
  totalAmount       Decimal            @db.Decimal(10, 2)
  currency          String
  startsAt          DateTime?
  expiresAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments          SubscriptionPayment[]
  mapUnlocks        SubscriptionMapUnlock[]

  @@index([userId, status, expiresAt])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id                String                     @id @default(uuid())
  userId            String
  subscriptionId    String
  amount            Decimal                    @db.Decimal(10, 2)
  currency          String
  status            SubscriptionPaymentStatus  @default(PENDING)
  gatewaySessionId  String?                    @unique
  gatewayReference  String?
  paidAt            DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription      Subscription               @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([subscriptionId, status])
  @@map("subscription_payments")
}

model SubscriptionMapUnlock {
  id             String       @id @default(uuid())
  userId         String
  subscriptionId String
  propertyId     String
  unlockedAt     DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, propertyId])
  @@index([userId, subscriptionId])
  @@map("subscription_map_unlocks")
}

model LocationLockSetting {
  id                  String           @id @default("global_setting")
  enabledGlobally     Boolean          @default(false)
  unlockFeeAmount     Decimal          @default(15.00) @db.Decimal(10, 2)
  unlockFeeCurrency   String           @default("USD")
  gatewayEnabled      Boolean          @default(true)
  merchantCodeEnabled Boolean          @default(true)
  merchantCode        String           @default("SHELTER-MBL-784")
  merchantName        String           @default("Sheltered Global Escrow Services Ltd")
  paymentInstructions String
  supportedChannels   String[]         @default(["MTN Mobile Money", "Airtel Money", "Stanbic FlexiPay", "Bank Wire"])
  txIdMinLength       Int              @default(6)
  txIdMaxLength       Int              @default(30)
  txIdRegexPattern    String           @default("^[A-Za-z0-9_-]+$")
  verificationMode    VerificationMode @default(AUTOMATIC)
  updatedAt           DateTime         @updatedAt

  @@map("location_lock_settings")
}

model Payment {
  id                String          @id @default(uuid())
  userId            String
  propertyId        String
  paymentMethod     PaymentMethod
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("USD")
  status            PaymentStatus   @default(PENDING)
  purpose           String          @default("LOCATION_UNLOCK")
  gatewaySessionId  String?         @unique
  gatewayReference  String?
  gatewayReceiptUrl String?
  merchantCode      String?
  submittedTxId     String?
  rejectionReason   String?
  verifiedAt        DateTime?
  verifiedByAdminId String?
  auditNotes        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  locationUnlock    LocationUnlock?
  property          Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([propertyId, status])
  @@index([submittedTxId])
  @@map("payments")
}

model LocationUnlock {
  id           String        @id @default(uuid())
  userId       String
  propertyId   String
  paymentId    String?       @unique
  unlockMethod PaymentMethod
  unlockedAt   DateTime      @default(now())
  payment      Payment?      @relation(fields: [paymentId], references: [id])
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@map("location_unlocks")
}

model Media {
  id                  String    @id @default(uuid())
  propertyId          String
  storageKey          String    @unique
  publicUrl           String
  mimeType            String
  fileSize            Int
  kind                MediaKind @default(IMAGE)
  thumbnailStorageKey String?
  thumbnailUrl        String?
  isActive            Boolean   @default(true)
  sortOrder           Int       @default(0)
  isFeatured          Boolean   @default(false)
  createdAt           DateTime  @default(now())
  property            Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, isActive])
  @@map("property_media")
}

model MediaUploadBatch {
  id         String   @id @default(uuid())
  ownerId    String
  propertyId String
  manifest   Json
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, expiresAt])
  @@index([expiresAt, consumedAt])
  @@map("media_upload_batches")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  details    String
  targetType String
  targetId   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String   @db.Text
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}


enum Role {
  BUYER
  SELLER
  AGENT
  ADMIN
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ACTIVE
  REJECTED
  CORRECTION_REQUESTED
  SOLD
  RENTED
  ARCHIVED
}

enum PaymentMethod {
  GATEWAY_STRIPE
  MERCHANT_CODE
  MANUAL_ADMIN_OVERRIDE
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  DUPLICATE
  FAILED
  EXPIRED
}

enum VerificationMode {
  AUTOMATIC
  MANUAL_ADMIN_REVIEW
}

enum SubscriptionPlan {
  FREE
  PAID
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  REVOKED
  FAILED
}

enum SubscriptionPaymentStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}
