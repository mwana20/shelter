generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  fullName            String
  phone               String?
  dateOfBirth         DateTime
  country             String?
  role                Role                 @default(BUYER)
  emailVerified       Boolean              @default(false)
  phoneVerified       Boolean              @default(false)
  companyName         String?
  agencyLicense       String?
  avatarUrl           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  bio                 String?
  district            String?
  neighborhood        String?
  region              String?
  auditLogs           AuditLog[]
  unlockedProperties  LocationUnlock[]
  passwordResetTokens PasswordResetToken[]
  payments            Payment[]
  properties          Property[]           @relation("OwnerProperties")
  verificationTokens  VerificationToken[]

  @@map("users")
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  code      String
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Property {
  id                  String                @id @default(uuid())
  slug                String                @unique
  title               String
  description         String
  propertyType        String
  listingType         String
  price               Decimal               @db.Decimal(14, 2)
  currency            String                @default("USD")
  status              PropertyStatus        @default(PENDING_REVIEW)
  bedrooms            Int?
  bathrooms           Decimal?              @db.Decimal(3, 1)
  landSizeSqFt        Decimal?              @db.Decimal(12, 2)
  builtYear           Int?
  featured            Boolean               @default(false)
  viewsCount          Int                   @default(0)
  country             String
  region              String
  district            String
  neighborhood        String?
  exactAddress        String?
  latitude            Float?
  longitude           Float?
  directionsGuide     String?
  cadastralPlotNumber String?
  ownerId             String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  locationUnlocks     LocationUnlock[]
  payments            Payment[]
  owner               User                  @relation("OwnerProperties", fields: [ownerId], references: [id])
  lockOverride        PropertyLockOverride?
  media               Media[]

  @@map("properties")
}

model PropertyLockOverride {
  id         String   @id @default(uuid())
  propertyId String   @unique
  isLocked   Boolean  @default(true)
  customFee  Decimal? @db.Decimal(10, 2)
  reason     String?
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_lock_overrides")
}

model LocationLockSetting {
  id                  String           @id @default("global_setting")
  enabledGlobally     Boolean          @default(false)
  unlockFeeAmount     Decimal          @default(15.00) @db.Decimal(10, 2)
  unlockFeeCurrency   String           @default("USD")
  gatewayEnabled      Boolean          @default(true)
  merchantCodeEnabled Boolean          @default(true)
  merchantCode        String           @default("SHELTER-MBL-784")
  merchantName        String           @default("Sheltered Global Escrow Services Ltd")
  paymentInstructions String
  supportedChannels   String[]         @default(["MTN Mobile Money", "Airtel Money", "Stanbic FlexiPay", "Bank Wire"])
  txIdMinLength       Int              @default(6)
  txIdMaxLength       Int              @default(30)
  txIdRegexPattern    String           @default("^[A-Za-z0-9_-]+$")
  verificationMode    VerificationMode @default(AUTOMATIC)
  updatedAt           DateTime         @updatedAt

  @@map("location_lock_settings")
}

model Payment {
  id                String          @id @default(uuid())
  userId            String
  propertyId        String
  paymentMethod     PaymentMethod
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("USD")
  status            PaymentStatus   @default(PENDING)
  purpose           String          @default("LOCATION_UNLOCK")
  gatewaySessionId  String?         @unique
  gatewayReference  String?
  gatewayReceiptUrl String?
  merchantCode      String?
  submittedTxId     String?
  rejectionReason   String?
  verifiedAt        DateTime?
  verifiedByAdminId String?
  auditNotes        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  locationUnlock    LocationUnlock?
  property          Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([propertyId, status])
  @@index([submittedTxId])
  @@map("payments")
}

model LocationUnlock {
  id           String        @id @default(uuid())
  userId       String
  propertyId   String
  paymentId    String?       @unique
  unlockMethod PaymentMethod
  unlockedAt   DateTime      @default(now())
  payment      Payment?      @relation(fields: [paymentId], references: [id])
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@map("location_unlocks")
}

model Media {
  id         String   @id @default(uuid())
  propertyId String
  storageKey String   @unique
  publicUrl  String
  mimeType   String
  fileSize   Int
  sortOrder  Int      @default(0)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_media")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  details    String
  targetType String
  targetId   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

enum Role {
  BUYER
  SELLER
  AGENT
  ADMIN
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ACTIVE
  REJECTED
  SOLD
  RENTED
  ARCHIVED
}

enum PaymentMethod {
  GATEWAY_STRIPE
  MERCHANT_CODE
  MANUAL_ADMIN_OVERRIDE
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  DUPLICATE
  FAILED
  EXPIRED
}

enum VerificationMode {
  AUTOMATIC
  MANUAL_ADMIN_REVIEW
}
