# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public company details only. VITE_ values are included in browser assets.
VITE_COMPANY_NAME="Sheltered"
VITE_COMPANY_ADDRESS=""
VITE_COMPANY_PHONES=""
VITE_COMPANY_WHATSAPP=""
VITE_COMPANY_EMAIL=""
VITE_COMPANY_SUPPORT_HOURS=""
VITE_COMPANY_FACEBOOK=""
VITE_COMPANY_INSTAGRAM=""
VITE_COMPANY_LINKEDIN=""
VITE_DEFAULT_LANGUAGE="en"

# Public service URLs. Configure only after the corresponding server endpoints exist.
VITE_CONTACT_FORM_ENDPOINT=""
VITE_AUTH_API_URL=""
VITE_MEDIA_UPLOAD_ENDPOINT=""
VITE_LISTING_SUBMISSION_ENDPOINT=""
